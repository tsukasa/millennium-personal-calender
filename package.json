{
  "name": "io.tsukasa.personal-calendar",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "starlight watch",
    "build": "bun -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && starlight pack",
